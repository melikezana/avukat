NEXT_PUBLIC_SITE_URL="https://www.idrisdagkesen.av.tr"

# Iletisim formu mail gonderimi
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
CONTACT_EMAIL="avukat@example.com"
CONTACT_FROM_EMAIL="site@example.com"

# Admin modulu eklendiginde kullanilir
ADMIN_USERNAME="admin"
